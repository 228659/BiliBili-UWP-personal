<UserControl
    x:Class="BiliBili_UWP.Components.Account.LoginPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BiliBili_UWP.Components.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:widgets="using:BiliBili_UWP.Components.Widgets"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <UserControl.Resources>
        <Storyboard x:Name="PopupIn">
            <DoubleAnimation From="0"
                             To="1"
                             Duration="00:00:00.5"
                             Storyboard.TargetName="PopupContainer"
                             Storyboard.TargetProperty="Opacity"
                             >
                <DoubleAnimation.EasingFunction>
                    <PowerEase EasingMode="EaseOut"></PowerEase>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation From="0"
                             To="1"
                             Duration="00:00:00.5"
                             Storyboard.TargetName="PopupBackground"
                             Storyboard.TargetProperty="Opacity"
                             >
                <DoubleAnimation.EasingFunction>
                    <PowerEase EasingMode="EaseOut"></PowerEase>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation From="-20"
                             To="0"
                             Duration="00:00:00.5"
                             Storyboard.TargetName="PopupContainer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             >
                <DoubleAnimation.EasingFunction>
                    <PowerEase EasingMode="EaseOut"></PowerEase>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="PopupOut">
            <DoubleAnimation From="1"
                             To="0"
                             Duration="00:00:00.5"
                             Storyboard.TargetName="PopupContainer"
                             Storyboard.TargetProperty="Opacity"
                             >
                <DoubleAnimation.EasingFunction>
                    <PowerEase EasingMode="EaseOut"></PowerEase>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation From="1"
                             To="0"
                             Duration="00:00:00.5"
                             Storyboard.TargetName="PopupBackground"
                             Storyboard.TargetProperty="Opacity"
                             >
                <DoubleAnimation.EasingFunction>
                    <PowerEase EasingMode="EaseOut"></PowerEase>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation From="0"
                             To="20"
                             Duration="00:00:00.5"
                             Storyboard.TargetName="PopupContainer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             >
                <DoubleAnimation.EasingFunction>
                    <PowerEase EasingMode="EaseOut"></PowerEase>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="PopupBackground"
          Background="{ThemeResource ScreenMaskColor}">
        <Viewbox MinWidth="350" MaxWidth="450" StretchDirection="Both" x:Name="PopupContainer" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Viewbox.RenderTransform>
                <TranslateTransform Y="-20"></TranslateTransform>
            </Viewbox.RenderTransform>

            <Grid Padding="40,25" Background="{ThemeResource PageBackground}" CornerRadius="5" Width="450" MinHeight="480">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource BasicIconTextStyle}" FontSize="40" HorizontalAlignment="Left"
                   Foreground="{ThemeResource PrimaryColor}" Text="&#xE903;"/>
                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="扫码登录" Grid.Row="1" Margin="0,20,0,0"/>
                <Grid Grid.Row="2" Margin="0,25,0,0" Width="240" Height="240" HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="5">
                        <Image x:Name="QrImage" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <ProgressRing x:Name="QrLoadingRing" IsActive="True" Width="45" Height="45"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"
                            Content="刷新二维码" Visibility="Collapsed" Click="RefreshButton_Click"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="StatusBlock" Grid.Row="3" Margin="0,20,0,0" TextAlignment="Center"
                           TextWrapping="Wrap" Style="{StaticResource TipTextStyle}"
                           Text="请使用哔哩哔哩手机客户端扫码登录"/>
                <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,25,0,0" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource TipTextStyle}" Text="扫码后请在手机上确认登录" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource PrimaryGhostCircleButtonStyle}" Content="&#xEA15;" VerticalAlignment="Top"
                        HorizontalAlignment="Right" x:Name="CloseButton" Click="CloseButton_Click" Margin="0,-10,-15,0"/>
            </Grid>

        </Viewbox>
    </Grid>
</UserControl>
